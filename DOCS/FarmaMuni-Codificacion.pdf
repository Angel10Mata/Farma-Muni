(export async function obtenerProductosYClientes\(\) {) Tj
T* (  try {) Tj
T* (    const supabase = await createClient\(\);) Tj
T* () Tj
T* (    // Obtener productos activos) Tj
T* (    const { data: productos, error: prodError } = await supabase) Tj
T* (      .from\("inv_productos"\)) Tj
T* (      .select\("*"\)) Tj
T* (      .eq\("activo", true\)) Tj
T* (      .order\("nombre", { ascending: true }\);) Tj
T* () Tj
T* (    if \(prodError\) throw new Error\(prodError.message\);) Tj
T* () Tj
T* (    // Obtener todos los clientes) Tj
T* (    const { data: clientes, error: cliError } = await supabase) Tj
T* (      .from\("ven_clientes"\)) Tj
T* (      .select\("*"\)) Tj
T* (      .order\("nombre", { ascending: true }\);) Tj
T* () Tj
T* (    if \(cliError\) throw new Error\(cliError.message\);) Tj
T* () Tj
T* (    return {) Tj
T* (      productos: productos || [],) Tj
T* (      clientes: clientes || [],) Tj
T* (    };) Tj
T* (  } catch \(error: any\) {) Tj
T* (    console.error\("Error en obtenerProductosYClientes:", error\);) Tj
T* (    throw new Error\("No se pudieron cargar los productos o clientes."\);) Tj
